# Local development overrides. Copy to `.env` (git-ignored) and fill in only what you need.
# All values below are optional: app.config.ts has working defaults.
#
# Cloud builds (EAS) do NOT read this file. Set build-time values on EAS instead:
#   expo.dev → tidy-tasks-mobile-app → Environment variables
#   or: eas env:create --name NAME --value VALUE --environment preview --environment production
# Never put secrets (tokens, keys) in any committed file.

# --- App identity (permanent once published; normally leave unset) ---
# ANDROID_PACKAGE_BASE=com.mik_dev.tidytaskmobile
# IOS_BUNDLE_ID_BASE=com.mik-dev.tidytaskmobile

# --- Public URLs shown in the app ---
# EXPO_PUBLIC_SITE_URL=https://nikskr.github.io/tidy-tasks
# EXPO_PUBLIC_PRIVACY_URL=https://nikskr.github.io/tidy-tasks/privacy/
# EXPO_PUBLIC_SUPPORT_EMAIL=mgpmessage@gmail.com

# --- Sentry crash reporting (public DSN; empty = reporting off) ---
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org-id>.ingest.sentry.io/<project-id>
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=   ← secret: set on EAS with --visibility secret, not here
