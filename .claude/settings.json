{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test:*)",
      "Bash(npx jest:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx expo lint)",
      "Bash(npx expo-doctor)",
      "Bash(npx expo config:*)",
      "Bash(npx expo export:*)",
      "Bash(npx expo install:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(npx eas-cli@latest build:list:*)",
      "Bash(npx eas-cli@latest build:view:*)",
      "mcp__sentry",
      "mcp__github"
    ],
    "ask": [
      "Bash(npx eas-cli@latest build:*)",
      "Bash(npx eas-cli@latest update:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Bash(eas submit:*)",
      "Bash(npx eas-cli@latest submit:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/google-service-account*.json)",
      "Read(./**/*.p8)",
      "Read(./**/*.jks)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/guard-bash.mjs" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/post-edit.mjs" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node scripts/hooks/verify-on-stop.mjs", "timeout": 300 }]
      }
    ]
  }
}
